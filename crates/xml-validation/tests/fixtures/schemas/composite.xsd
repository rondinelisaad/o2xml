<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:a="urn:article"
           xmlns:c="urn:common"
           targetNamespace="urn:article"
           elementFormDefault="qualified">
  <xs:import namespace="urn:common" schemaLocation="https://example.org/common.xsd"/>
  <xs:element name="article">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="c:common"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
