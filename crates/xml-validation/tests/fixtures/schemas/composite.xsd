<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:a="urn:article"
           xmlns:c="urn:common"
           targetNamespace="urn:article"
           elementFormDefault="qualified">
  <xs:import namespace="urn:common" schemaLocation="https://example.org/common.xsd"/>
  <xs:complexType name="ArticleType">
    <xs:sequence>
      <xs:element ref="c:common"/>
    </xs:sequence>
    <xs:attribute name="article-type" use="optional" fixed="research-article"/>
  </xs:complexType>
  <xs:element name="article" type="a:ArticleType"/>
</xs:schema>
