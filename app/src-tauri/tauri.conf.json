{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "O2XML",
  "version": "0.2.0",
  "identifier": "org.scielo.o2xml",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "title": "O2XML",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/jats",
      "resources/packtools-html"
    ],
    "externalBin": [
      "binaries/xml-libxml2-helper"
    ],
    "icon": [
      "generated-icons/32x32.png",
      "generated-icons/128x128.png",
      "generated-icons/128x128@2x.png",
      "generated-icons/icon.icns",
      "generated-icons/icon.ico"
    ]
  }
}
